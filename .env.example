# RAG application — required for pipelines, evaluation, and Streamlit app
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Environment tier: "dev" (Haiku 4.5, fast+cheap) or "prod" (Sonnet 4.6, best quality)
RAG_ENV=dev

# FastAPI backend — CORS allowed origin for the frontend (Docker: not needed; local dev: optional)
ALLOWED_ORIGIN=http://localhost:3000

# LinkedIn carousel upload (scripts/linkedin_post.py)
# Create an app at https://www.linkedin.com/developers/apps/
# Add product "Share on LinkedIn"; set redirect URI http://localhost:8080/callback
# Then run: uv run python scripts/linkedin_post.py --auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Data-fetch script only (scripts/fetch_ncua_data.py) — not needed to run the demo
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
APIFY_TOKEN=
